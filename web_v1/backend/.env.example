# PowerShell settings read these environment variables; this file is not auto-loaded.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
CRAFT_WORKER_PYTHON=
# Integration settings currently support application-owned SQLite development only.
# Legacy credentials are not consumed by the governance service or fixture worker.
# Live admission and production activation remain disabled.
# Ask CRAFT (optional): a free Groq API key lets an AI model read questions. Put the real key in
# web_v1/backend/.env (gitignored), never in this file. Only the question text is sent to Groq.
GROQ_API_KEY=
