# PowerShell settings read these environment variables; this file is not auto-loaded.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
CRAFT_WORKER_PYTHON=
# Integration settings currently support application-owned SQLite development only.
# Legacy credentials are not consumed by the governance service or fixture worker.
# Live admission and production activation remain disabled.
# Ask CRAFT (optional): a free Groq API key lets an AI model read questions. Put the real key in
# web_v1/backend/.env (gitignored), never in this file. Only the question text is sent to Groq.
GROQ_API_KEY=
# Auto-planning e-mail (optional). Real values go in web_v1/backend/.env only. With no host set,
# e-mails are saved as files in planning_runs/outbox. Gmail: smtp.gmail.com, port 587, an app password.
APP_BASE_URL=http://localhost:5173
CRAFT_EMAIL_HOST=
CRAFT_EMAIL_PORT=587
CRAFT_EMAIL_USER=
CRAFT_EMAIL_PASSWORD=
CRAFT_EMAIL_FROM=
# Demo copies: 1 = the app reads and writes <database>_demo instead of the original (see docs/demo_copies.md).
CRAFT_USE_DEMO_COPIES=0
# Write approved plans and machine status to the demo copies (needs the craft_writer account below).
CRAFT_WRITEBACK=0
CRAFT_WRITER_USER=
CRAFT_WRITER_PASSWORD=
# Auto-planning timing (minutes / hour of day); these are the defaults.
AUTO_PLAN_QUIET_MINUTES=15
AUTO_PLAN_MAX_WAIT_MINUTES=60
AUTO_PLAN_NEW_ORDER_CHECK_MINUTES=15
AUTO_CAPTURE_HOUR=2
# The factory clock for the nightly capture hour and e-mail times (an IANA zone name).
FACTORY_TIME_ZONE=Asia/Karachi
