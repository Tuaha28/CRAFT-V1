# Copy this file to .env and fill in your real local values.
# .env is listed in .gitignore and must NEVER be committed.
#
# NOTE: this file previously contained a real working database password.
# Placeholders only from here on -- an example file is committed, so anything
# written here is published.
DB_USER=root
DB_PASS=your-local-mysql-password
DB_HOST=localhost
DB_NAME=garment_fyp_db
DB_PORT=3306

# CRAFT legacy extraction only. An authorized DBA must create and verify this
# SELECT-only account separately. Never use DB_USER/root for extraction.
# Leave the password blank until it is supplied through approved local secrets.
LEGACY_DB_NAME=garment_fyp_db
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_USER=craft_reader
LEGACY_DB_PASSWORD=

GNN_HIDDEN_CHANNELS=64
GNN_EPOCHS=100
GNN_LEARNING_RATE=0.005
GNN_DROPOUT=0.3

GA_POPULATION_SIZE=50
GA_GENERATIONS=50
# GA_MUTATION_RATE removed -- ga/scheduler.py derives the mutation rate
# dynamically from problem size instead (see utils/config.py's comment).

# Business constraints
MACHINE_RESERVE_FRACTION=0.07
IDLE_LABOR_WEIGHT=480

OPENAI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
